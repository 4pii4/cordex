{
  "name": "@4pii4/cordex",
  "version": "0.2.1",
  "description": "Control OpenAI Codex from Discord with persistent projects, sessions, approvals, and live output",
  "keywords": [
    "openai",
    "codex",
    "discord",
    "bot",
    "cli",
    "developer-tools",
    "automation"
  ],
  "license": "GPL-3.0-only",
  "private": false,
  "type": "module",
  "bin": {
    "cordex": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "CONTRIBUTING.md",
    "LICENSE",
    "SECURITY.md",
    "THIRD_PARTY_NOTICES.md"
  ],
  "scripts": {
    "clean": "node --input-type=module -e \"import { rmSync } from 'node:fs'; rmSync('dist', { recursive: true, force: true })\"",
    "build": "npm run clean && tsc -p tsconfig.json",
    "typecheck:test": "tsc -p tsconfig.test.json",
    "dev": "tsx src/cli.ts start",
    "start": "node dist/cli.js start",
    "test": "node --import tsx --test test/*.test.ts",
    "test:live": "cross-env CORDEX_LIVE_TEST=1 CORDEX_INPUT_TEST=1 CORDEX_WORKTREE_TEST=1 CORDEX_SCHEDULER_TEST=1 node --import tsx --test test/live-codex*.test.ts",
    "test:live-all": "npm run test:live && npm run test:live-review && npm run test:live-approval && npm run test:live-discord-controls && npm run test:live-login && npm run test:live-account && npm run test:live-mcp-config && npm run test:live-mcp-reload && npm run test:live-mcp-elicitation && npm run test:live-subagent && npm run test:live-action-buttons && npm run test:live-output-retry && npm run test:live-progress && npm run test:live-startup-progress && npm run test:live-direct-recovery && npm run test:live-ambiguous-delivery && npm run test:live-model-notices && npm run test:live-status && npm run test:live-generated-image && npm run test:live-file-upload && npm run test:live-file-upload-tool && npm run test:live-background-notice && npm run test:live-session-history && npm run test:live-extensions && npm run test:live-plugin-lifecycle && npm run test:live-lifecycle",
    "test:live-evidence": "node scripts/live-e2e-runner.mjs start",
    "test:live-scheduler": "cross-env CORDEX_SCHEDULER_TEST=1 node --import tsx --test test/live-codex-scheduler.test.ts",
    "test:live-approval": "cross-env CORDEX_APPROVAL_TEST=1 node --import tsx --test test/live-codex-approval.test.ts",
    "test:live-account": "cross-env CORDEX_ACCOUNT_TEST=1 node --import tsx --test test/live-codex-account.test.ts",
    "test:live-action-buttons": "cross-env CORDEX_ACTION_BUTTONS_TEST=1 node --import tsx --test test/live-codex-action-buttons.test.ts",
    "test:live-output-retry": "cross-env CORDEX_OUTPUT_RETRY_TEST=1 node --import tsx --test test/live-codex-output-retry.test.ts",
    "test:live-progress": "cross-env CORDEX_SILENT_PROGRESS_TEST=1 node --import tsx --test test/live-codex-silent-progress.test.ts",
    "test:live-startup-progress": "cross-env CORDEX_STARTUP_PROGRESS_TEST=1 node --import tsx --test test/live-codex-startup-progress.test.ts",
    "test:live-direct-recovery": "cross-env CORDEX_DIRECT_RECOVERY_TEST=1 node --import tsx --test test/live-codex-direct-recovery.test.ts",
    "test:live-ambiguous-delivery": "cross-env CORDEX_AMBIGUOUS_DELIVERY_TEST=1 node --import tsx --test test/live-codex-ambiguous-delivery.test.ts",
    "test:live-model-notices": "cross-env CORDEX_MODEL_NOTICES_TEST=1 node --import tsx --test test/live-codex-model-notices.test.ts",
    "test:live-status": "cross-env CORDEX_STATUS_TEST=1 node --import tsx --test test/live-codex-status.test.ts",
    "test:live-generated-image": "cross-env CORDEX_GENERATED_IMAGE_TEST=1 node --import tsx --test test/live-codex-generated-image.test.ts",
    "test:live-file-upload": "cross-env CORDEX_FILE_UPLOAD_TEST=1 node --import tsx --test test/live-codex-file-upload.test.ts",
    "test:live-file-upload-tool": "cross-env CORDEX_FILE_UPLOAD_TOOL_TEST=1 node --import tsx --test test/live-codex-file-upload-tool.test.ts",
    "test:live-background-notice": "cross-env CORDEX_BACKGROUND_NOTICE_TEST=1 node --import tsx --test test/live-codex-background-notice.test.ts",
    "test:live-session-history": "cross-env CORDEX_SESSION_HISTORY_TEST=1 node --import tsx --test test/live-codex-session-history.test.ts",
    "test:live-extensions": "cross-env CORDEX_EXTENSIONS_TEST=1 node --import tsx --test test/live-codex-extensions.test.ts",
    "test:live-plugin-lifecycle": "cross-env CORDEX_PLUGIN_LIFECYCLE_TEST=1 node --import tsx --test test/live-codex-plugin-lifecycle.test.ts",
    "test:live-lifecycle": "cross-env CORDEX_LIFECYCLE_TEST=1 node --import tsx --test test/live-codex-lifecycle.test.ts",
    "test:live-discord-controls": "cross-env CORDEX_DISCORD_CONTROLS_TEST=1 node --import tsx --test test/live-codex-discord-controls.test.ts",
    "test:live-input": "cross-env CORDEX_INPUT_TEST=1 node --import tsx --test test/live-codex-input.test.ts",
    "test:live-login": "cross-env CORDEX_LOGIN_TEST=1 node --import tsx --test test/live-codex-login.test.ts",
    "test:live-mcp-config": "cross-env CORDEX_MCP_CONFIG_TEST=1 node --import tsx --test test/live-codex-mcp-config.test.ts",
    "test:live-mcp-reload": "cross-env CORDEX_MCP_RELOAD_TEST=1 node --import tsx --test test/live-codex-mcp-reload.test.ts",
    "test:live-mcp-elicitation": "cross-env CORDEX_MCP_ELICITATION_TEST=1 node --import tsx --test test/live-codex-mcp-elicitation.test.ts",
    "test:live-review": "cross-env CORDEX_REVIEW_TEST=1 node --import tsx --test test/live-codex-review.test.ts",
    "test:live-subagent": "cross-env CORDEX_SUBAGENT_TEST=1 node --import tsx --test test/live-codex-subagent.test.ts",
    "check": "npm run build && npm run typecheck:test && npm test",
    "prepack": "npm run build",
    "prepublishOnly": "npm run check"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "discord.js": "^14.26.3"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "cross-env": "^10.1.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  },
  "publishConfig": {
    "access": "public"
  }
}
